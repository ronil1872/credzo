# Supabase Configuration (Placeholders only - never commit real secrets here)
# Copy this file to .env.local and fill in your Supabase project values.
#
# SECURITY: Only the Publishable Key should ever be in browser code.
# Never put your service_role or secret key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Web Push Notifications (RFC 8292 VAPID)
# Generate fresh keys anytime using: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=BNHBJJ7A0K6RGvryAqOH0efKkKe2W6UYFeC2DTvJOnsWCcWp9NkowSdfpv5KzFxa8QJGN69vfQIK1bgCwC2Tm2Q

